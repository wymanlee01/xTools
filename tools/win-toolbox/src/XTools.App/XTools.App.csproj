<Project Sdk="Microsoft.NET.Sdk">
  <!-- 应用入口：托盘菜单、注册模块、偏好设置窗口、检查更新 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标 NotifyIcon 和带自定义按钮的 TaskDialog 来自 WinForms -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>xTools</AssemblyName>
    <RootNamespace>XTools.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 界面是 WPF，DPI 感知按 WPF 的做法写在 app.manifest 里；这条是给纯 WinForms 程序的建议 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms 和 WPF 有同名类型（Application、MessageBox…），不全局引入 WinForms，用到时写全名 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../XTools.Platform/XTools.Platform.csproj" />
  </ItemGroup>
</Project>
